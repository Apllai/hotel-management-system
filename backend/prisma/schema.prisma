generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPTIONIST
  MANAGER
  HOUSEKEEPING
  GUEST
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  DELUXE
  SUITE
  FAMILY
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEAN
  DIRTY
  OUT_OF_SERVICE
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(GUEST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile StaffProfile?
  auditLogs    AuditLog[]
}

model StaffProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  employeeId  String?   @unique
  phone       String?
  department  String?
  salary      Decimal?  @db.Decimal(12, 2)
  hiredAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guest {
  id              String        @id @default(cuid())
  fullName        String
  email           String?       @unique
  phone           String?
  address         String?
  documentType    DocumentType?
  documentNumber  String?
  nationality     String?
  specialRequests String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reservations Reservation[]
  payments     Payment[]
}

model Room {
  id                  String            @id @default(cuid())
  roomNumber          String            @unique
  roomType            RoomType
  floor               Int
  capacity            Int
  bedConfiguration    String
  pricePerNight       Decimal           @db.Decimal(10, 2)
  amenities          String[]
  description         String?
  status              RoomStatus        @default(AVAILABLE)
  housekeepingStatus  HousekeepingStatus @default(CLEAN)
  active              Boolean           @default(true)
  imageUrl            String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  reservations Reservation[]
  tasks         HousekeepingTask[]
  requests      MaintenanceRequest[]
}

model Reservation {
  id               String            @id @default(cuid())
  bookingReference String            @unique
  guestId          String
  roomId           String?
  checkIn          DateTime
  checkOut         DateTime
  adults           Int
  children         Int
  nights           Int
  roomRate         Decimal           @db.Decimal(10, 2)
  taxes            Decimal           @db.Decimal(10, 2)
  additionalCharges Decimal          @db.Decimal(10, 2)
  discount         Decimal           @db.Decimal(10, 2)
  total            Decimal           @db.Decimal(10, 2)
  paymentStatus    PaymentStatus     @default(PENDING)
  status           ReservationStatus @default(PENDING)
  specialRequests  String?
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  guest     Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  room      Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  invoices  Invoice[]
  payments  Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String
  guestId        String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invoice     Invoice?
}

model Invoice {
  id            String   @id @default(cuid())
  reservationId  String
  paymentId     String?  @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(10, 2)
  taxes         Decimal  @db.Decimal(10, 2)
  discounts     Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  paidAmount    Decimal  @db.Decimal(10, 2) @default(0)
  balance       Decimal  @db.Decimal(10, 2) @default(0)
  issuedAt      DateTime @default(now())
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model AdditionalService {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HousekeepingTask {
  id          String             @id @default(cuid())
  roomId      String
  title       String
  status      HousekeepingStatus @default(DIRTY)
  priority    MaintenancePriority @default(MEDIUM)
  dueDate     DateTime?
  notes       String?
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model MaintenanceRequest {
  id          String             @id @default(cuid())
  roomId      String
  title       String
  description String?
  priority    MaintenancePriority @default(MEDIUM)
  status      String             @default("OPEN")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model HotelSettings {
  id                  String   @id @default(cuid())
  hotelName           String
  currency            String   @default("USD")
  taxRate             Decimal  @db.Decimal(5, 2)
  serviceFee          Decimal  @db.Decimal(5, 2)
  cancellationPolicy  String?
  checkInTime         String?
  checkOutTime        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
